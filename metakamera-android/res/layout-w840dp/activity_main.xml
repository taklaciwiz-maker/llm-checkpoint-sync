<?xml version="1.0" encoding="utf-8"?>
<!-- Wide screens (landscape phones, tablets): media list on the left, device/options/actions on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mk_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ScrollView
            android:id="@+id/scroll_media"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="88dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="8dp">

                <include layout="@layout/part_header" />

                <include layout="@layout/card_media" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/scroll_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="88dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="16dp">

                <include layout="@layout/card_device" />

                <include layout="@layout/card_options" />

                <include layout="@layout/card_actions" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/part_message_bar" />
</FrameLayout>
