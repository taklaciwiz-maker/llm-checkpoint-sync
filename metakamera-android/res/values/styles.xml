<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme (light). values-night/styles.xml redefines the Theme.MetaKamera.* parents for dark mode. -->
    <style name="Theme.MetaKamera" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/mk_accent</item>
        <item name="android:colorPrimaryDark">@color/mk_bg</item>
        <item name="android:colorAccent">@color/mk_accent</item>
        <item name="android:colorControlActivated">@color/mk_accent</item>
        <item name="android:colorControlNormal">@color/mk_text2</item>
        <item name="android:colorBackground">@color/mk_bg</item>
        <item name="android:windowBackground">@color/mk_bg</item>
        <item name="android:statusBarColor">@color/mk_bg</item>
        <item name="android:navigationBarColor">@color/mk_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.MetaKamera.Alert</item>
    </style>

    <style name="Theme.MetaKamera.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorPrimary">@color/mk_accent</item>
        <item name="android:colorAccent">@color/mk_accent</item>
        <item name="android:colorControlActivated">@color/mk_accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="Theme.MetaKamera.Alert" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorPrimary">@color/mk_accent</item>
        <item name="android:colorAccent">@color/mk_accent</item>
    </style>

    <!-- Root of the MK.* widget styles (dotted names inherit from it). -->
    <style name="MK" />

    <!-- Cards & text -->
    <style name="MK.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/mk_card_gap</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/mk_card_padding</item>
    </style>

    <style name="MK.CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mk_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="MK.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/mk_text</item>
    </style>

    <style name="MK.Secondary">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/mk_text2</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="MK.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/mk_text2</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Buttons -->
    <style name="MK.Button" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MK.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="MK.Button.Tonal">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/btn_tonal_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="MK.Button.Text">
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:textColor">@color/btn_tonal_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="MK.Check">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/mk_text</item>
        <item name="android:buttonTint">@color/mk_accent</item>
    </style>

    <style name="MK.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/mk_text</item>
        <item name="android:textColorHint">@color/mk_hint</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">text|textNoSuggestions</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
</resources>
