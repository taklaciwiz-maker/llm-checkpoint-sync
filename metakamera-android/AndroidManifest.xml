<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.metakamera.app">

    <!-- Unredacted EXIF GPS when reading MediaStore items (API 29+). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Saving into DCIM/Pictures on Android 8.0-9 (API 26-28); MediaStore needs no permission on 29+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- android:roundIcon is not used: it is an API 25 attribute that aapt v1 cannot resolve against the
         API 23 android.jar, and with minSdk 26 the adaptive launcher icon below is masked by the launcher anyway. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetaKamera">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Read-only access to edited files (cacheDir/edited) for sharing. -->
        <provider
            android:name=".EditedFileProvider"
            android:authorities="com.metakamera.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
