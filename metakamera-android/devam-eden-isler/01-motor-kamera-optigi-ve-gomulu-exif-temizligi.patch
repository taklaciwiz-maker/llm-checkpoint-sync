+     * of IFD1: that nested block is edited in place, both by edit() and by scrubInPlace().
+     */
+    public static void testThumbnailOwnExifScrubbed() throws Exception {
+        for (boolean le : new boolean[]{true, false}) {
+            // the thumbnail's own EXIF (as Xiaomi writes it, same byte order)
+            Opt n = opt(le);
+            n.make = "Xiaomi";
+            n.model = "M2012K11AG";
+            n.software = null;
+            n.lensModel = null;
+            n.makerNote = false;
+            n.serials = false;
+            n.gps = false;
+            n.interop = false;
+            n.thumbnail = false;
+            n.extraIfd0.add(ascii(0x9A00, "POCO F3"));
+            byte[] nested = build(n).tiff;
+            byte[] thumb = withExif(thumbJpeg(), nested);
+            Opt o = opt(le);
+            o.make = "Xiaomi";
+            o.model = "M2012K11AG";
+            o.thumbData = thumb;
+            Fx fx = build(o);
+            File before = jpeg("thumbexif-" + le + "-in.jpg", fx.tiff);
+            File thIn = T.file("thumbexif-" + le + "-thumb-in.jpg");
+            T.write(thIn, exiftoolThumbnail(before));
+            T.eq("POCO F3", T.exif(thIn).get("IFD0:XiaomiModel"), "fixture: exiftool reads the thumbnail's EXIF");
+
+            EditReport rep = new EditReport();
+            byte[] out = edit(fx.tiff, T.appleSpec(), rep);
+            absent(out, "Xiaomi", "make in the thumbnail EXIF");
+            absent(out, "POCO F3", "XiaomiModel in the thumbnail EXIF");
+            absent(out, "M2012K11AG", "model in the thumbnail EXIF");
+            T.check(hasChange(rep, "Küçük resim: EXIF Make: Xiaomi → Apple"), "rep " + rep);
+            T.check(hasChange(rep, "Küçük resim: EXIF XiaomiModel kaldırıldı"), "rep " + rep);
+            T.check(hasChange(rep, "Küçük resim: EXIF Model temizlendi (yeni değer sığmadı)"), "rep " + rep);
+            TR tr = new TR(out);
+            T.eq((long) fx.thumbPos, tr.field(tr.ifd1(), 0x0201), "thumbnail not moved");
+            T.eq((long) thumb.length, tr.field(tr.ifd1(), 0x0202), "thumbnail length unchanged");
+            File after = jpeg("thumbexif-" + le + "-out.jpg", out);
+            File thOut = T.file("thumbexif-" + le + "-thumb-out.jpg");
+            T.write(thOut, exiftoolThumbnail(after));
+            T.eq(thumb.length, (int) thOut.length(), "thumbnail size");
+            Map<String, String> mt = T.exif(thOut);
+            T.eq("Apple", mt.get("IFD0:Make"), "thumbnail EXIF make");
+            T.eq(null, mt.get("IFD0:XiaomiModel"), "thumbnail XiaomiModel removed");
+            T.eq("0", T.exec("compare", "-metric", "AE", thIn.getPath(), thOut.getPath(), "null:").out.trim(), "thumbnail pixels identical");
+            assertNoNewWarnings(before, after);
+            T.check(edit(out, T.appleSpec(), new EditReport()) == out, "idempotent");
+
+            // nothing to change in the main block, only in the thumbnail: a copy is returned
+            EditSpec mk = nullSpec();
+            mk.make = "Xiaomi";
+            mk.removeMakerNote = true;
+            Opt clean = opt(le);
+            clean.make = "Xiaomi";
+            clean.model = "M2012K11AG";
+            clean.makerNote = false;
+            clean.thumbData = thumb;
+            Fx cf = build(clean);
+            byte[] copy = cf.tiff.clone();
+            EditReport rc = new EditReport();
+            byte[] co = edit(cf.tiff, mk, rc);
+            T.check(co != cf.tiff, "the thumbnail's XiaomiModel still has to go");
+            T.check(Arrays.equals(copy, cf.tiff), "input not modified");
+            T.eq(Arrays.asList("Küçük resim: EXIF XiaomiModel kaldırıldı"), rc.changes, "report");
+            T.eq(cf.tiff.length, co.length, "same size");
+
+            // scrubInPlace follows the thumbnail too
+            byte[] b = embed(fx.tiff);
+            EditReport rs = new EditReport();
+            T.check(ExifTiff.scrubInPlace(b, 37, fx.tiff.length, T.appleSpec(), rs, WHERE), "parsed");
+            byte[] sc = embedded(b, fx.tiff.length);
+            absent(sc, "Xiaomi", "scrub: make");
+            absent(sc, "POCO F3", "scrub: thumbnail XiaomiModel");
+            T.check(hasChange(rs, WHERE + ", küçük resim: EXIF Make: Xiaomi → Apple"), "rep " + rs);
+        }
+    }
