+            T.eq("HUAWEI", tr.str(tr.ifd0(), 0x010F), "shared slot not written");
+            T.check(hasWarningContaining(rep, WHERE + ": EXIF Make değiştirilemedi"), "warned " + rep);
+
+            // SHORT pixel size that needs a LONG: the 4-byte field is re-typed in place
