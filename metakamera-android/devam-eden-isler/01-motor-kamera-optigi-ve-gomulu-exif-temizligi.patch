+    public static void testOpticsInvalidValuesIgnored() throws Exception {
+        Fx fx = build(opticsOpt(true));
+        double[] bad = {Double.NaN, -1, 0, Double.POSITIVE_INFINITY, 1e12, 0.0001};
+        for (double v : bad) {
+            EditSpec s = nullSpec();
+            s.focalLengthMm = v;
+            s.fNumber = v;
+            s.lensSpecification = new double[]{v, v, v, v};
+            EditReport rep = new EditReport();
+            T.check(edit(fx.tiff, s, rep) == fx.tiff, "invalid value " + v + " ignored: " + rep);
+        }
+        EditSpec s = nullSpec();
+        s.focalLength35mm = 0;
+        s.lensSpecification = new double[]{1, 2, 3};
+        s.exifImageWidth = -5;
+        s.exifImageHeight = 100;
+        T.check(edit(fx.tiff, s, new EditReport()) == fx.tiff, "invalid 35mm / lens spec / size ignored");
+        s.focalLength35mm = 70000;
+        T.check(edit(fx.tiff, s, new EditReport()) == fx.tiff, "35mm beyond SHORT ignored");
+        // f-number below 1: FNumber is written, but no (negative) APEX value
+        EditSpec f = nullSpec();
+        f.fNumber = 0.95;
+        EditReport rep = new EditReport();
+        byte[] out = edit(fx.tiff, f, rep);
+        T.eq(Arrays.asList("EXIF FNumber: f/1.8 → f/0.95"), rep.changes, "report");
+        TR tr = new TR(out);
+        T.eq(-1, tr.entry(tr.exif(), 0x9202), "no ApertureValue");
+        T.eq("297/100", rat(tr, tr.exif(), 0x9205, 0), "MaxApertureValue untouched");
+        // unknown entries of a LensSpecification are written as 0/0
+        EditSpec l = nullSpec();
+        l.lensSpecification = new double[]{6.765, 6.765, 1.78, Double.NaN};
+        rep = new EditReport();
+        out = edit(fx.tiff, l, rep);
+        tr = new TR(out);
+        T.eq("0/0", rat(tr, tr.exif(), 0xA432, 3), "unknown -> 0/0");
+        T.eq(Arrays.asList("EXIF LensSpecification: 4.2-12.6 mm f/1.8-3.5 → 6.765 mm f/1.78-?"), rep.changes, "report");
+        T.check(edit(out, l, new EditReport()) == out, "idempotent with unknown values");
+    }
