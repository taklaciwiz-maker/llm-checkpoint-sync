+        Integer h = spec.exifImageHeight;
+        if (w != null && h != null && w > 0 && h > 0) {
+            r.add(new Req(TiffFile.TAG_PIXEL_X, "PixelXDimension", K_DIM, w, null, true));
+            r.add(new Req(TiffFile.TAG_PIXEL_Y, "PixelYDimension", K_DIM, h, null, true));
+        }
+        return r;
+    }
+
+    /** True when the existing entry already holds {@code q}'s value (and a type that needs no rewrite). */
+    static boolean holds(TiffFile tf, TiffEntry e, Req q) {
+        switch (q.kind) {
+            case K_FOCAL:
