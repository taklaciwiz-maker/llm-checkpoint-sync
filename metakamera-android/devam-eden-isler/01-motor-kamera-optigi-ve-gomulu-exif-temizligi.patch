+    /** Rational encoding, 32-bit limits and locale-independent formatting. */
+    public static void testOpticsEncodingAndFormatting() throws Exception {
+        T.eq("6765/1000", str(Optics.rational(6.765, 1000)), "6.765");
+        T.eq("178/100", str(Optics.rational(1.78, 100)), "1.78");
+        T.eq("6930/1000", str(Optics.rational(6.93, 1000)), "6.93");
+        T.eq("6766/1000", str(Optics.rational(6.7655, 1000)), "rounded to the denominator");
+        T.eq("500000000/100", str(Optics.rational(5e6, 1000)), "denominator reduced to fit 32 bits");
+        T.eq("4000000000/1", str(Optics.rational(4e9, 1000)), "down to /1");
+        T.eq(null, Optics.rational(5e9, 1000), "too large");
+        T.eq(null, Optics.rational(0.0004, 1000), "rounds to 0");
+        T.eq(null, Optics.rational(Double.NaN, 1000), "NaN");
+        T.eq(null, Optics.rational(-1, 1000), "negative");
+        T.eq("6.765", Optics.fmt(6.765, 3), "fmt");
+        T.eq("24", Optics.fmt(24.0, 3), "fmt integer");
+        T.eq("1.4", Optics.fmt(1.4, 2), "fmt");
+        T.eq("0.97", Optics.fmt(0.9708, 2), "fmt round");
+        T.eq("2.8", Optics.fmt(2.7995, 2), "fmt round up");
+        T.eq("-1.5", Optics.fmt(-1.5, 2), "fmt negative");
+        T.eq("?", Optics.fmt(Double.NaN, 2), "fmt NaN");
+        near(1.6638, Optics.apex(1.78), 1e-4, "apex");
+        near(1.78, Optics.fNumberFromApex(Optics.apex(1.78)), 1e-12, "apex round trip");
+        T.eq("2.22-9 mm f/1.78-2.8", Optics.lensSpecText(new double[]{2.22, 9, 1.78, 2.8}), "lens text");
+        T.eq("6.765 mm f/1.78", Optics.lensSpecText(new double[]{6.765, 6.765, 1.78, 1.78}), "lens text single");
+        // a Turkish default locale (decimal comma) must not leak into reports or values
+        java.util.Locale old = java.util.Locale.getDefault();
+        try {
+            java.util.Locale.setDefault(new java.util.Locale("tr", "TR"));
+            EditReport rep = new EditReport();
+            byte[] out = edit(build(opticsOpt(true)).tiff, withOptics(nullSpec()), rep);
+            T.check(hasChange(rep, "EXIF FocalLength: 6.7 → 6.765 mm"), "decimal point in report " + rep);
+            T.eq("6765/1000", rat(new TR(out), new TR(out).exif(), 0x920A, 0), "value");
+        } finally {
+            java.util.Locale.setDefault(old);
+        }
+    }
