+    public static void testScrubInPlaceFuzzNeverThrows() throws Exception {
+        List<byte[]> seeds = new ArrayList<byte[]>();
+        for (boolean le : new boolean[]{true, false}) {
+            seeds.add(build(opticsOpt(le)).tiff);
+            Opt o = opt(le);
+            o.ifd1MakeModel = true;
+            o.lensMake = "HUAWEI";
+            o.shareMakeWithLensMake = true;
+            seeds.add(build(o).tiff);
+        }
+        seeds.add(build(xiaomiOpt(true, null)).tiff);
+        seeds.add(brandTextFixture(false).fx.tiff);
+        seeds.add(ExifTiff.createMinimal(withOptics(T.appleSpec()), 100, 100));
+        EditSpec removal = nullSpec();
+        removal.make = "";
+        removal.model = "";
+        removal.lensModel = "";
+        removal.removeMakerNote = true;
+        removal.clearSerials = true;
+        EditSpec[] specs = {withOptics(T.appleSpec()), removal};
+        Random rnd = new Random(20261102L);
+        long[] interesting = {0, 1, 2, 4, 7, 8, 0xFFFF, 0x7FFFFFFFL, 0x80000000L, 0xFFFFFFFFL, 0xFFFFFFF0L};
+        int n = 0;
+        int ok = 0;
+        for (byte[] seed : seeds) {
+            TR tr = new TR(seed);
+            List<Integer> entryPos = new ArrayList<Integer>();
+            int[] ifds = {tr.ifd0(), tr.exif(), tr.ifd1()};
+            for (int ifd : ifds) {
+                if (ifd <= 0 || ifd >= seed.length) continue;
+                for (int k = 0; k < tr.tags(ifd); k++) entryPos.add(ifd + 2 + 12 * k);
+            }
+            TB w = new TB(seed[0] == 'I');
+            for (int iter = 0; iter < 500; iter++) {
+                byte[] b = seed.clone();
+                int kind = rnd.nextInt(5);
+                if (kind == 0) {
+                    int flips = 1 + rnd.nextInt(8);
+                    for (int f = 0; f < flips; f++) b[rnd.nextInt(b.length)] = (byte) rnd.nextInt(256);
+                } else if (kind == 1) {
+                    b = Arrays.copyOf(b, rnd.nextInt(b.length + 1));
+                } else if (!entryPos.isEmpty()) {
+                    int e = entryPos.get(rnd.nextInt(entryPos.size()));
+                    long v = rnd.nextBoolean() ? interesting[rnd.nextInt(interesting.length)] : rnd.nextInt(seed.length + 16);
+                    w.b = b;
+                    if (kind == 2) w.put16(e + 2, rnd.nextInt(16));
+                    else if (kind == 3) w.put32(e + 4, v);
+                    else w.put32(e + 8, v);
+                }
+                for (EditSpec s : specs) {
+                    byte[] buf = embed(b);
+                    byte[] orig = buf.clone();
+                    EditReport rep = new EditReport();
+                    boolean parsed;
+                    try {
+                        parsed = ExifTiff.scrubInPlace(buf, 37, b.length, s, rep, WHERE);
+                    } catch (Throwable t) {
+                        AssertionError ae = new AssertionError("scrub threw for seed#" + seeds.indexOf(seed) + " iter " + iter);
+                        ae.initCause(t);
+                        throw ae;
+                    }
+                    String what = "fuzz seed#" + seeds.indexOf(seed) + " iter " + iter + " kind " + kind;
+                    outsideUnchanged(orig, buf, b.length, what);
+                    if (!parsed) {
+                        T.check(Arrays.equals(orig, buf), what + ": modified although not parsed");
+                        T.check(rep.changes.isEmpty() && rep.warnings.isEmpty(), what + ": report filled although not parsed");
+                    } else {
+                        ok++;
+                        T.check(allPrefixed(rep, WHERE + ": "), what + ": prefix " + rep);
+                        // the result is still a parseable block for both editors
+                        byte[] res = embedded(buf, b.length);
+                        T.check(ExifTiff.scrubInPlace(buf, 37, b.length, s, new EditReport(), WHERE), what + ": re-parse");
+                        ExifTiff.inspect(res, new MediaInfo());
+                        try {
+                            ExifTiff.edit(res, s, Integer.MAX_VALUE, new EditReport());
+                        } catch (UnsupportedFormatException e) {
+                            T.check(e.getCause() == null, what + ": internal error in edit after scrub");
+                        }
+                    }
+                    n++;
+                }
+            }
+        }
+        T.check(n >= 6000, "fuzz iterations " + n);
+        T.check(ok > n / 3, "too few parsed fuzz inputs: " + ok + " of " + n);
+    }
