+package com.metakamera.core.tiff;
+
+import com.metakamera.core.EditSpec;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Camera-module optics ({@link EditSpec#focalLengthMm}, {@link EditSpec#fNumber}, ...): value
+ * validation, the RATIONAL encoding shared by EXIF and XMP, "same value" tolerances and the
+ * (locale independent) report formatting.
+ *
+ * <p>Encodings: FocalLength n/1000 (6.765 mm → 6765/1000), FNumber n/100 (1.78 → 178/100),
+ * ApertureValue / MaxApertureValue as APEX 2·log2(N) in n/1000. A value whose numerator would not
+ * fit in 32 bits uses a 10× smaller denominator (down to /1); a value that still does not fit,
+ * or is not a positive finite number, is ignored. Values are compared with the precision they are
+ * written with, and apertures by their f-number (two decimals), so a second identical edit is a
+ * no-op even for vendor encodings such as Apple's ApertureValue 27767/23734 (f/1.5).
+ */
+public final class Optics {
+
+    /** Denominator of FocalLength (and the focal values of LensSpecification). */
+    public static final long FOCAL_DEN = 1000;
+    /** Denominator of FNumber (and the F values of LensSpecification). */
+    public static final long FNUMBER_DEN = 100;
+    /** Denominator of the APEX ApertureValue / MaxApertureValue. */
+    public static final long APEX_DEN = 1000;
+
+    private static final double LN2 = Math.log(2);
+    private static final long U32_MAX = 0xFFFFFFFFL;
+
+    private Optics() {
+    }
+
+    // ================================================================== public helpers
+
+    /** True for a finite value &gt; 0 that can be written as a RATIONAL with {@code den}. */
+    public static boolean valid(Double v, long den) {
+        return v != null && rational(v, den) != null;
+    }
+
+    /**
+     * {numerator, denominator} for {@code v} with the preferred denominator (10× smaller ones when
+     * the numerator would not fit in 32 bits); null for NaN, infinite, &lt;= 0, too small to be
+     * represented (rounds to 0) or too large values.
+     */
+    public static long[] rational(double v, long den) {
+        if (Double.isNaN(v) || Double.isInfinite(v) || v <= 0 || den <= 0) return null;
+        for (long d = den; d >= 1; d /= 10) {
+            double n = Math.floor(v * d + 0.5);
+            if (n <= U32_MAX) {
+                if (n < 1) return null;
+                return new long[]{(long) n, d};
+            }
+        }
+        return null;
+    }
+
+    /** APEX aperture value 2·log2(N) of an f-number. */
+    public static double apex(double fNumber) {
+        return 2 * Math.log(fNumber) / LN2;
+    }
+
+    /** f-number of an APEX aperture value: 2^(AV/2). */
+    public static double fNumberFromApex(double av) {
+        return Math.pow(2, av / 2);
+    }
+
+    /** {@code a} and {@code b} are equal at the precision of denominator {@code den} (both NaN = equal). */
+    public static boolean same(double a, double b, long den) {
+        if (Double.isNaN(a) || Double.isNaN(b)) return Double.isNaN(a) && Double.isNaN(b);
+        return Math.abs(a - b) <= 0.5 / den + 1e-9 * Math.max(1, Math.abs(b));
+    }
+
+    /** Two f-numbers that print the same with two decimals (1.78 vs 1.7800001, 1.5 vs 1.49999). */
+    public static boolean sameAperture(double fa, double fb) {
+        if (Double.isNaN(fa) || Double.isNaN(fb)) return false;
+        return Math.abs(fa - fb) < 0.005;
+    }
+
+    /**
+     * {@code v} rounded to at most {@code decimals} decimals without trailing zeros, '.' as the
+     * decimal separator (never locale dependent): 6.765 → "6.765", 24.0 → "24", 1.4 → "1.4".
+     * NaN / infinite → "?".
+     */
