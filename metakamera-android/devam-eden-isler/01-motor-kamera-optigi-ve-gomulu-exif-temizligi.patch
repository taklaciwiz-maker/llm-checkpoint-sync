+        }
+    }
+
+    /**
+     * The new entry value for {@code q}: {type, count} in {@code typeCount}, bytes (file byte
+     * order) returned. {@code existingType} is the type of the entry being replaced (-1 = new).
+     */
+    static byte[] encode(TiffFile tf, Req q, int existingType, long[] typeCount) {
+        switch (q.kind) {
+            case K_FOCAL:
+                return rationalBytes(tf, q.value, FOCAL_DEN, typeCount);
+            case K_FNUMBER:
+                return rationalBytes(tf, q.value, FNUMBER_DEN, typeCount);
+            case K_APEX:
+                return rationalBytes(tf, Math.max(0, apex(q.value)), APEX_DEN, typeCount);
+            case K_SHORT: {
+                byte[] b = new byte[2];
+                tf.put16(b, 0, (int) q.value);
+                typeCount[0] = TiffFile.T_SHORT;
+                typeCount[1] = 1;
+                return b;
+            }
+            case K_DIM: {
+                long v = (long) q.value;
+                if (existingType == TiffFile.T_SHORT && v <= 0xFFFF) {
+                    byte[] b = new byte[2];
+                    tf.put16(b, 0, (int) v);
+                    typeCount[0] = TiffFile.T_SHORT;
+                    typeCount[1] = 1;
+                    return b;
+                }
+                byte[] b = new byte[4];
+                tf.put32(b, 0, v);
+                typeCount[0] = TiffFile.T_LONG;
+                typeCount[1] = 1;
+                return b;
+            }
+            case K_LENS_SPEC: {
+                byte[] b = new byte[32];
+                for (int i = 0; i < 4; i++) {
+                    long[] nd = Double.isNaN(q.values[i]) ? null : rational(q.values[i], i < 2 ? FOCAL_DEN : FNUMBER_DEN);
+                    if (nd != null) {
+                        tf.put32(b, 8 * i, nd[0]);
+                        tf.put32(b, 8 * i + 4, nd[1]);
+                    }
+                }
+                typeCount[0] = TiffFile.T_RATIONAL;
+                typeCount[1] = 4;
+                return b;
+            }
+            default:
+                throw new IllegalArgumentException("kind " + q.kind);
+        }
+    }
+
+    private static byte[] rationalBytes(TiffFile tf, double v, long den, long[] typeCount) {
+        long[] nd = rational(v, den);
+        if (nd == null) nd = new long[]{0, 1}; // APEX 0 (f/1.0) or a value that rounds to 0
+        byte[] b = new byte[8];
+        tf.put32(b, 0, nd[0]);
+        tf.put32(b, 4, nd[1]);
+        typeCount[0] = TiffFile.T_RATIONAL;
+        typeCount[1] = 1;
+        return b;
+    }
+
+    /** Report text of the current value of {@code e} for the field of {@code q} (no unit). */
+    static String oldText(TiffFile tf, TiffEntry e, Req q) {
+        if (q.kind == K_LENS_SPEC) {
+            double[] v = new double[4];
+            for (int i = 0; i < 4; i++) v[i] = tf.number(e, i);
+            return lensSpecText(v);
+        }
+        double v = tf.number(e, 0);
+        if (q.kind == K_APEX) v = Double.isNaN(v) ? v : fNumberFromApex(v);
+        return valueText(q.kind, v);
+    }
+
+    /** Report text of the new value of {@code q}. */
+    static String newText(Req q) {
+        if (q.kind == K_LENS_SPEC) return lensSpecText(q.values);
+        return valueText(q.kind, q.value);
+    }
+
+    private static String valueText(int kind, double v) {
+        switch (kind) {
+            case K_FOCAL:
+                return fmt(v, 3);
+            case K_FNUMBER:
+            case K_APEX:
+                return "f/" + fmt(v, 2);
+            default:
+                return fmt(v, 0);
+        }
+    }
+
+    /** Unit appended once at the end of a report line ("EXIF FocalLength: 6.7 → 6.93 mm"). */
+    static String unit(Req q) {
+        return q.kind == K_FOCAL ? " mm" : "";
+    }
+}
