+        T.eq("1664/1000", rat(tr, ex, 0x9202, 0), "ApertureValue = 2*log2(1.78) = 1.6638");
+        T.eq("1664/1000", rat(tr, ex, 0x9205, 0), "MaxApertureValue updated (present)");
+        T.eq("2220/1000", rat(tr, ex, 0xA432, 0), "LensSpecification min focal");
+        T.eq("9000/1000", rat(tr, ex, 0xA432, 1), "LensSpecification max focal");
