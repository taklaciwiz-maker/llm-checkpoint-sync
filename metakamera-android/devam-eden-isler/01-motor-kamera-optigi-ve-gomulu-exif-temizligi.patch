+    // =====================================================================================
+    // Tests: scrubInPlace (secondary EXIF blocks that must keep their size)
+    // =====================================================================================
+
+    static final String WHERE = "MPF görüntü 2";
+
+    /** {@code tiff} embedded at offset 37 of a buffer with recognizable bytes before and after. */
+    static byte[] embed(byte[] tiff) {
+        byte[] buf = new byte[37 + tiff.length + 23];
+        for (int i = 0; i < buf.length; i++) buf[i] = (byte) (0xA0 + i % 7);
+        System.arraycopy(tiff, 0, buf, 37, tiff.length);
+        return buf;
+    }
+
+    static byte[] embedded(byte[] buf, int len) {
+        return Arrays.copyOfRange(buf, 37, 37 + len);
+    }
+
+    static void outsideUnchanged(byte[] before, byte[] after, int len, String what) {
+        T.eq(before.length, after.length, what + ": buffer length");
+        for (int i = 0; i < 37; i++) T.check(before[i] == after[i], what + ": byte before the block changed at " + i);
+        for (int i = 37 + len; i < before.length; i++) T.check(before[i] == after[i], what + ": byte after the block changed at " + i);
+    }
+
+    static boolean allPrefixed(EditReport r, String prefix) {
+        for (String c : r.changes) if (!c.startsWith(prefix)) return false;
+        for (String w : r.warnings) if (!w.startsWith(prefix)) return false;
+        return true;
+    }
+
