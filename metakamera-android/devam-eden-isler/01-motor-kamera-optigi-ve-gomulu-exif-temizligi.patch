+        File before = jpeg("optics-" + tag + "-in.jpg", fx.tiff);
+        File after = jpeg("optics-" + tag + "-out.jpg", out);
+        Map<String, String> m = T.exif(after);
+        T.eq("6.8 mm", m.get("ExifIFD:FocalLength"), "exiftool FocalLength");
+        T.eq("24 mm", m.get("ExifIFD:FocalLengthIn35mmFormat"), "exiftool 35mm");
+        T.eq("1.8", m.get("ExifIFD:FNumber"), "exiftool FNumber");
+        T.eq("1.8", m.get("ExifIFD:ApertureValue"), "exiftool ApertureValue");
+        T.eq("1.8", m.get("ExifIFD:MaxApertureValue"), "exiftool MaxApertureValue");
+        T.eq("5712", m.get("ExifIFD:ExifImageWidth"), "exiftool width");
+        T.eq("4284", m.get("ExifIFD:ExifImageHeight"), "exiftool height");
+        T.eq("HUAWEI", m.get("IFD0:Make"), "identity untouched (null spec)");
+        Map<String, String> n = T.exif(after, "-n");
+        T.eq("6.765", n.get("ExifIFD:FocalLength"), "exiftool -n FocalLength");
+        T.eq("1.78", n.get("ExifIFD:FNumber"), "exiftool -n FNumber");
+        near(1.78, num(n, "ExifIFD:ApertureValue"), 0.005, "exiftool -n ApertureValue as f-number");
+        near(1.78, num(n, "ExifIFD:MaxApertureValue"), 0.005, "exiftool -n MaxApertureValue");
+        T.eq("2.22 9 1.78 2.8", n.get("ExifIFD:LensInfo"), "exiftool -n LensInfo");
+        assertNoNewWarnings(before, after);
