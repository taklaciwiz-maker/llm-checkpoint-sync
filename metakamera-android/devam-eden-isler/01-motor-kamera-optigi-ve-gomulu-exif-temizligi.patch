+    static final int K_FOCAL = 0;
+    /** FNumber: RATIONAL /100, shown as "f/1.4". */
+    static final int K_FNUMBER = 1;
+    /** ApertureValue / MaxApertureValue: APEX RATIONAL /1000 of {@link Req#value} (an f-number), shown as "f/1.4". */
+    static final int K_APEX = 2;
+    /** FocalLengthIn35mmFormat: SHORT. */
+    static final int K_SHORT = 3;
+    /** PixelX/YDimension: SHORT or LONG (existing type kept; LONG when created or &gt; 65535). */
+    static final int K_DIM = 4;
+    /** LensSpecification: 4 RATIONALs (focal /1000, F /100; unknown = 0/0). */
+    static final int K_LENS_SPEC = 5;
+
+    /** One optics field to write. */
+    static final class Req {
+        final int tag;
+        final String name;
+        final int kind;
+        /** The value (K_APEX: the f-number, not the APEX value). */
+        final double value;
+        /** K_LENS_SPEC values (NaN = unknown). */
+        final double[] values;
+        /** May be created when missing (otherwise only an existing entry is updated). */
+        final boolean create;
+
+        Req(int tag, String name, int kind, double value, double[] values, boolean create) {
+            this.tag = tag;
+            this.name = name;
+            this.kind = kind;
+            this.value = value;
+            this.values = values;
+            this.create = create;
+        }
+    }
+
+    /**
+     * The EXIF optics fields requested by {@code spec}, in report order. Invalid values (see class
+     * comment; f-numbers below 1 give no ApertureValue; 35 mm focal lengths outside 1..65535;
+     * pixel sizes not given together or &lt;= 0) are left out.
+     */
+    static List<Req> requests(EditSpec spec) {
+        List<Req> r = new ArrayList<Req>(8);
+        if (spec == null) return r;
+        if (valid(spec.focalLengthMm, FOCAL_DEN)) {
+            r.add(new Req(TiffFile.TAG_FOCAL_LENGTH, "FocalLength", K_FOCAL, spec.focalLengthMm, null, true));
+        }
+        if (spec.focalLength35mm != null && spec.focalLength35mm > 0 && spec.focalLength35mm <= 0xFFFF) {
+            r.add(new Req(TiffFile.TAG_FOCAL_LENGTH_35MM, "FocalLengthIn35mmFormat", K_SHORT, spec.focalLength35mm, null, true));
+        }
+        if (valid(spec.fNumber, FNUMBER_DEN)) {
+            double n = spec.fNumber;
+            r.add(new Req(TiffFile.TAG_FNUMBER, "FNumber", K_FNUMBER, n, null, true));
+            if (n >= 1) { // APEX >= 0 (ApertureValue is unsigned)
+                r.add(new Req(TiffFile.TAG_APERTURE_VALUE, "ApertureValue", K_APEX, n, null, true));
+                r.add(new Req(TiffFile.TAG_MAX_APERTURE_VALUE, "MaxApertureValue", K_APEX, n, null, false));
+            }
+        }
+        double[] ls = spec.lensSpecification;
+        if (ls != null && ls.length == 4) {
+            double[] v = new double[4];
+            boolean any = false;
+            for (int i = 0; i < 4; i++) {
+                v[i] = known(ls[i]);
+                if (!Double.isNaN(v[i]) && rational(v[i], i < 2 ? FOCAL_DEN : FNUMBER_DEN) == null) v[i] = Double.NaN;
+                if (!Double.isNaN(v[i])) any = true;
+            }
+            if (any) r.add(new Req(TiffFile.TAG_LENS_SPECIFICATION, "LensSpecification", K_LENS_SPEC, 0, v, false));
+        }
