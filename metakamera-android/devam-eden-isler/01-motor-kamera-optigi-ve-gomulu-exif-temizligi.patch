+        scrub(true);
+    }
+
+    public static void testScrubInPlaceBigEndian() throws Exception {
+        scrub(false);
+    }
+
+    private static void scrub(boolean le) throws Exception {
+        String tag = le ? "le" : "be";
+        // HUAWEI optics fixture + MakerNote, serials, brand texts in IFD0/Exif/IFD1, IFD1 Make/Model
+        Opt o2 = opticsOpt(le);
+        o2.ifd1MakeModel = true;
+        List<Ent> texts = new ArrayList<Ent>();
+        Ent desc = ascii(0x010E, "Shot on aln-al00 night mode");
+        Ent xpComment = xp(0x9C9C, "HUAWEI XMAGE");
+        Ent xpSubject = xp(0x9C9F, "Tatil 2025");
+        Ent uc = userComment("UNICODE", "Çekim: HUAWEI P60 Pro", le);
+        Ent desc1 = ascii(0x010E, "ALN-AL00 thumbnail");
+        o2.extraIfd0.add(desc);
+        o2.extraIfd0.add(xpComment);
+        o2.extraIfd0.add(xpSubject);
+        o2.extraExif.add(uc);
+        o2.extraIfd1.add(desc1);
+        texts.add(desc);
+        texts.add(xpComment);
+        texts.add(uc);
+        texts.add(desc1);
+        Fx fx = build(o2);
+        byte[] tiff = fx.tiff;
+        TR in = new TR(tiff);
+        int ifd0Count = in.tags(in.ifd0());
+        int exifCount = in.tags(in.exif());
+        int ifd1Count = in.tags(in.ifd1());
+
+        EditSpec spec = withOptics(T.appleSpec());
+        byte[] buf = embed(tiff);
+        byte[] orig = buf.clone();
+        EditReport rep = new EditReport();
+        T.check(ExifTiff.scrubInPlace(buf, 37, tiff.length, spec, rep, WHERE), "parsed");
+        outsideUnchanged(orig, buf, tiff.length, "scrub");
+        byte[] out = embedded(buf, tiff.length);
+        TR tr = new TR(out);
+
+        // nothing moved: IFD positions and pointers are the same
+        T.eq(in.ifd0(), tr.ifd0(), "IFD0 in place");
+        T.eq(in.exif(), tr.exif(), "Exif IFD in place");
+        T.eq(in.ifd1(), tr.ifd1(), "IFD1 pointer kept (moved with the IFD0 entries)");
+        T.eq(in.field(in.ifd0(), 0x8825), tr.field(tr.ifd0(), 0x8825), "GPS pointer");
+        T.eq((long) fx.thumbPos, tr.field(tr.ifd1(), 0x0201), "thumbnail offset");
+        // entries removed in place: counts decremented, tails zero-filled, order kept
+        T.eq(ifd0Count - 2, tr.tags(tr.ifd0()), "IFD0: ImageDescription + XPComment removed");
+        T.eq(exifCount - 6, tr.tags(tr.exif()), "Exif IFD: MakerNote + 4 serials + UserComment removed");
+        T.eq(ifd1Count - 1, tr.tags(tr.ifd1()), "IFD1: ImageDescription removed");
+        int[][] ifds = {{in.ifd0(), ifd0Count, 2}, {in.exif(), exifCount, 6}, {in.ifd1(), ifd1Count, 1}};
+        for (int[] f : ifds) {
+            int newEnd = f[0] + 2 + 12 * (f[1] - f[2]) + 4;
+            int oldEnd = f[0] + 2 + 12 * f[1] + 4;
+            for (int i = newEnd; i < oldEnd; i++) T.check(out[i] == 0, "freed IFD tail zeroed at " + i);
+            assertSorted(tr, f[0], "IFD at " + f[0]);
+        }
+        for (int i = 0; i < fx.makerNoteLen; i++) T.check(out[fx.makerNotePos + i] == 0, "makernote zero-filled at " + i);
+        for (Ent e : texts) zeroed(out, e, "brand text 0x" + Integer.toHexString(e.tag));
+        intact(out, xpSubject, "unrelated XPSubject");
+        absent(out, "HUAWEI", "old make");
+        absent(out, "ALN-AL00", "old model");
+        absent(out, "aln-al00", "old model (lower case)");
+        absentUcs2(out, "HUAWEI", "old make (UTF-16)");
+        absent(out, "SECRETVENDOR", "makernote");
+        absent(out, "VNDRNOTE", "makernote");
+        absent(out, "SN-HW-123456", "serial");
+        absent(out, "LSN-999", "lens serial");
+        absent(out, "Ali Veli", "owner");
+        absent(out, "0123456789ABCDEF0123456789ABCDEF", "unique id");
+        // strings: written when they fit, blanked otherwise; never created
+        T.eq("Apple", tr.str(tr.ifd0(), 0x010F), "Make fits the 7-byte slot");
+        T.eq(7L, tr.u32(tr.entry(tr.ifd0(), 0x010F) + 4), "count kept");
+        T.eq("", tr.str(tr.ifd0(), 0x0110), "Model does not fit: blanked");
+        T.eq("26.0.1", tr.str(tr.ifd0(), 0x0131), "Software fits");
+        T.eq(-1, tr.entry(tr.ifd0(), 0x013C), "HostComputer not created");
+        T.eq(-1, tr.entry(tr.exif(), 0xA433), "LensMake not created");
+        T.eq("", tr.str(tr.exif(), 0xA434), "LensModel does not fit: blanked");
+        T.eq("Apple", tr.str(tr.ifd1(), 0x010F), "IFD1 Make");
+        T.eq("", tr.str(tr.ifd1(), 0x0110), "IFD1 Model blanked");
+        // optics: overwritten in place, ApertureValue (absent) not created
+        T.eq("6765/1000", rat(tr, tr.exif(), 0x920A, 0), "FocalLength");
+        T.eq("178/100", rat(tr, tr.exif(), 0x829D, 0), "FNumber");
+        T.eq("1664/1000", rat(tr, tr.exif(), 0x9205, 0), "MaxApertureValue");
+        T.eq("9000/1000", rat(tr, tr.exif(), 0xA432, 1), "LensSpecification");
+        T.eq(-1, tr.entry(tr.exif(), 0x9202), "ApertureValue not created");
+        T.eq(24, tr.u16(tr.entry(tr.exif(), 0xA405) + 8), "35mm");
+        T.eq(5712L, tr.u32(tr.entry(tr.exif(), 0xA002) + 8), "PixelXDimension");
+
+        File before = jpeg("scrub-" + tag + "-in.jpg", tiff);
+        File after = jpeg("scrub-" + tag + "-out.jpg", out);
+        Map<String, String> m = T.exif(after);
+        T.eq("Apple", m.get("IFD0:Make"), "exiftool make");
+        T.eq("", m.get("IFD0:Model"), "exiftool model blank");
+        T.eq("26.0.1", m.get("IFD0:Software"), "exiftool software");
+        T.eq("Apple", m.get("IFD1:Make"), "exiftool IFD1 make");
+        T.eq(null, m.get("IFD0:ImageDescription"), "description gone");
+        T.eq("Tatil 2025", m.get("IFD0:XPSubject"), "unrelated kept");
+        T.eq(null, m.get("ExifIFD:UserComment"), "comment gone");
+        T.eq(null, m.get("ExifIFD:SerialNumber"), "serial gone");
+        for (String k : m.keySet()) T.check(!k.contains("MakerNote") && !k.startsWith("MakerUnknown"), "makernote gone: " + k);
+        T.eq("6.8 mm", m.get("ExifIFD:FocalLength"), "focal");
+        T.eq("1.8", m.get("ExifIFD:FNumber"), "fnumber");
+        T.eq("2025:06:01 12:00:00", m.get("ExifIFD:DateTimeOriginal"), "dto kept");
+        T.eq("R98 - DCF basic file (sRGB)", m.get("InteropIFD:InteropIndex"), "interop kept");
+        T.eq("41 deg 0' 0.00\"", m.get("GPS:GPSLatitude"), "gps kept");
+        T.check(Arrays.equals(fx.thumb, exiftoolThumbnail(after)), "thumbnail bytes preserved");
+        assertNoNewWarnings(before, after);
+
+        T.check(allPrefixed(rep, WHERE + ": "), "every line prefixed: " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF Make: HUAWEI → Apple"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF Model temizlendi (yeni değer sığmadı)"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF Software: ALN-AL00 4.0.0.120(C00E120R1P1) → 26.0.1"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF LensModel temizlendi (yeni değer sığmadı)"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF IFD1 Make: HUAWEI → Apple"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": MakerNote temizlendi (VNDRNOTE)"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF ImageDescription" + TRACE), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF IFD1 ImageDescription" + TRACE), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF UserComment" + TRACE), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF BodySerialNumber kaldırıldı"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF FocalLength: 6.7 → 6.765 mm"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF FNumber: f/1.8 → f/1.78"), "rep " + rep);
+        T.check(hasChange(rep, WHERE + ": EXIF PixelXDimension: 64 → 5712"), "rep " + rep);
+        T.check(!hasChangeContaining(rep, "ApertureValue eklendi") && !hasChangeContaining(rep, "HostComputer"), "nothing created " + rep);
+        T.eq(0, rep.warnings.size(), "warnings " + rep);
+
+        // idempotent: a second scrub changes nothing and reports nothing
+        byte[] again = buf.clone();
+        EditReport rep2 = new EditReport();
+        T.check(ExifTiff.scrubInPlace(again, 37, tiff.length, spec, rep2, WHERE), "parsed again");
+        T.check(Arrays.equals(buf, again), "second scrub changes nothing");
+        T.eq(0, rep2.changes.size(), "second scrub report " + rep2);
+        MediaInfo info = new MediaInfo();
+        ExifTiff.inspect(out, info);
+        T.eq("Apple", info.make, "inspect make");
+        T.check(!info.hasMakerNote, "inspect makernote");
+        near(6.765, info.focalLengthMm, 1e-9, "inspect focal");
+
+        // the same block at offset 0 of an exact-size array, without a label
+        byte[] exact = tiff.clone();
+        EditReport r0 = new EditReport();
+        T.check(ExifTiff.scrubInPlace(exact, 0, exact.length, spec, r0, null), "offset 0");
+        T.check(Arrays.equals(out, exact), "same result at offset 0");
+        T.check(hasChange(r0, "EXIF Make: HUAWEI → Apple"), "no prefix " + r0);
+
+        // the options off: only identity strings and optics change, every removable tag stays
+        EditSpec keep = withOptics(T.appleSpec());
+        keep.removeMakerNote = false;
+        keep.clearSerials = false;
+        byte[] kb = embed(tiff);
+        EditReport rk = new EditReport();
+        T.check(ExifTiff.scrubInPlace(kb, 37, tiff.length, keep, rk, WHERE), "parsed");
+        byte[] ko = embedded(kb, tiff.length);
+        TR tk = new TR(ko);
+        T.eq(ifd0Count, tk.tags(tk.ifd0()), "IFD0 count kept");
+        T.eq(exifCount, tk.tags(tk.exif()), "Exif count kept");
+        T.check(Arrays.equals(fx.makerNote, Arrays.copyOfRange(ko, fx.makerNotePos, fx.makerNotePos + fx.makerNoteLen)), "makernote kept");
+        for (Ent e : texts) intact(ko, e, "text kept 0x" + Integer.toHexString(e.tag));
+        T.eq("SN-HW-123456", tk.str(tk.exif(), 0xA431), "serial kept");
+        T.check(!hasChangeContaining(rk, "kaldırıldı") && !hasChangeContaining(rk, "MakerNote"), "nothing removed " + rk);
+    }
