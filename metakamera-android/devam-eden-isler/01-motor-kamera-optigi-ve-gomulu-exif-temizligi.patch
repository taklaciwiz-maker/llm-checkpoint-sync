+            while (end > 0 && f.charAt(end - 1) == '0') end--;
+            sb.append('.').append(f, 0, end);
+        }
+        return sb.toString();
+    }
+
+    /** "1.57-5.7 mm f/1.5-1.8" style text of a 4-value LensSpecification (unknown values → "?"). */
+    public static String lensSpecText(double[] v) {
+        if (v == null || v.length < 4) return "?";
+        String focal = range(v[0], v[1], 3);
+        String f = range(v[2], v[3], 2);
+        return focal + " mm f/" + f;
+    }
+
+    private static String range(double a, double b, int decimals) {
+        String x = fmt(known(a), decimals);
+        String y = fmt(known(b), decimals);
