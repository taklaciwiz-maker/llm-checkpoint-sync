+    public static void testRealSamplesInspectEditAndScrub() throws Exception {
+        File dir = realSamples();
+        if (dir == null || !T.hasTool("exiftool")) {
+            System.out.println("SKIP ExifTiffTest.testRealSamplesInspectEditAndScrub: no real sample directory");
+            return;
+        }
+        int done = 0;
+        for (String rel : REAL_SAMPLES) {
+            if (!new File(dir, rel).isFile()) continue;
+            String base = new File(rel).getName().replace('.', '_');
+            File copy = T.file("real-" + new File(rel).getName());
+            byte[] tiff = realExif(dir, rel, copy);
+            T.check(tiff != null, rel + ": EXIF extracted");
+            File srcF = exifFile("real-" + base + "-src.exif", tiff);
+            Map<String, String> n0 = T.exif(srcF, "-n");
+            String oldMake = n0.get("IFD0:Make");
+
+            // inspect agrees with exiftool
+            MediaInfo info = new MediaInfo();
+            ExifTiff.inspect(tiff, info);
+            T.eq(oldMake, info.make, rel + ": inspect make");
+            String fl = n0.get("ExifIFD:FocalLength");
+            if (fl != null) near(Double.parseDouble(fl), info.focalLengthMm, 1e-6, rel + ": inspect focal");
+            else T.check(info.focalLengthMm == 0, rel + ": no focal length " + info.focalLengthMm);
+            String fn = n0.get("ExifIFD:FNumber");
+            if (fn != null) near(Double.parseDouble(fn), info.fNumber, 1e-6, rel + ": inspect fNumber");
+            String f35 = n0.containsKey("ExifIFD:FocalLengthIn35mmFormat") ? n0.get("ExifIFD:FocalLengthIn35mmFormat")
+                    : n0.get("IFD0:FocalLengthIn35mmFormat");
+            if (f35 != null && Integer.parseInt(f35) > 0) T.eq(Integer.parseInt(f35), info.focalLength35mm, rel + ": inspect 35mm");
+            String w = n0.get("ExifIFD:ExifImageWidth");
+            if (w != null) T.eq(Integer.parseInt(w), info.exifImageWidth, rel + ": inspect width");
+
+            // full edit (append strategy)
+            EditSpec spec = withOptics(T.appleSpec());
+            EditReport rep = new EditReport();
+            byte[] out = ExifTiff.edit(tiff, spec, Integer.MAX_VALUE, rep);
+            File outF = exifFile("real-" + base + "-edit.exif", out);
+            Map<String, String> m = T.exif(outF, "-n");
+            T.eq("Apple", m.get("IFD0:Make"), rel + ": make");
+            T.eq("iPhone 17 Pro Max", m.get("IFD0:Model"), rel + ": model");
+            T.eq("6.765", m.get("ExifIFD:FocalLength"), rel + ": focal");
+            T.eq("24", m.get("ExifIFD:FocalLengthIn35mmFormat"), rel + ": 35mm");
+            T.eq("1.78", m.get("ExifIFD:FNumber"), rel + ": fnumber");
+            near(1.78, num(m, "ExifIFD:ApertureValue"), 0.005, rel + ": aperture");
+            if (n0.containsKey("ExifIFD:MaxApertureValue")) near(1.78, num(m, "ExifIFD:MaxApertureValue"), 0.005, rel + ": max aperture");
+            else T.eq(null, m.get("ExifIFD:MaxApertureValue"), rel + ": MaxApertureValue not created");
+            if (n0.containsKey("ExifIFD:LensInfo")) T.eq("2.22 9 1.78 2.8", m.get("ExifIFD:LensInfo"), rel + ": lens info");
+            else T.eq(null, m.get("ExifIFD:LensInfo"), rel + ": LensInfo not created");
+            T.eq("5712", m.get("ExifIFD:ExifImageWidth"), rel + ": width");
+            T.eq("4284", m.get("ExifIFD:ExifImageHeight"), rel + ": height");
+            if (n0.containsKey("IFD0:FocalLengthIn35mmFormat")) T.eq("24", m.get("IFD0:FocalLengthIn35mmFormat"), rel + ": IFD0 copy");
+            for (String k : m.keySet()) {
+                T.check(!k.contains("MakerNote") && !k.startsWith("MakerUnknown") && !k.contains("Xiaomi"), rel + ": trace survived " + k);
+            }
+            String desc = m.get("IFD0:ImageDescription");
+            T.check(desc == null || !desc.toUpperCase(java.util.Locale.ROOT).contains("OLYMPUS"), rel + ": brand description " + desc);
+            assertNoNewWarnings(srcF, outF);
+            T.eq(n0.get("ExifIFD:DateTimeOriginal"), m.get("ExifIFD:DateTimeOriginal"), rel + ": date kept");
+            T.check(ExifTiff.edit(out, spec, Integer.MAX_VALUE, new EditReport()) == out, rel + ": idempotent");
+            if (oldMake != null && oldMake.trim().length() >= 2 && !oldMake.trim().equalsIgnoreCase("Apple")) {
+                absent(out, oldMake.trim(), rel + ": old make bytes after edit");
+            }
+            if (rel.endsWith("r_olympus.jpg") || rel.endsWith("r_pen.jpg")) {
+                T.check(hasChange(rep, "EXIF ImageDescription" + TRACE), rel + ": OLYMPUS DIGITAL CAMERA removed " + rep);
+                T.check(desc == null, rel + ": description gone");
+            }
+
+            // JPEG: put the edited block back (it must fit in APP1) and compare the pixels
+            if (rel.endsWith(".jpg")) {
+                byte[] jpg = T.read(copy);
+                byte[] app1 = ExifTiff.edit(tiff, spec, APP1_MAX, new EditReport());
+                File dst = T.file("real-" + base + "-out.jpg");
+                T.write(dst, withExif(jpg, app1));
+                T.eq("0", T.exec("compare", "-metric", "AE", copy.getPath(), dst.getPath(), "null:").out.trim(), rel + ": pixels identical");
+                T.eq("Apple", T.exif(dst).get("IFD0:Make"), rel + ": make in JPEG");
+            }
+
+            // in-place scrub of the same block (as for a secondary image)
+            byte[] buf = embed(tiff);
+            byte[] orig = buf.clone();
+            EditReport rs = new EditReport();
+            T.check(ExifTiff.scrubInPlace(buf, 37, tiff.length, spec, rs, WHERE), rel + ": scrub parsed");
+            outsideUnchanged(orig, buf, tiff.length, rel);
+            byte[] sc = embedded(buf, tiff.length);
+            File scF = exifFile("real-" + base + "-scrub.exif", sc);
+            Map<String, String> ms = T.exif(scF, "-n");
+            String mk = ms.get("IFD0:Make");
+            T.check("Apple".equals(mk) || "".equals(mk), rel + ": scrubbed make " + mk);
+            String md = ms.get("IFD0:Model");
+            T.check(md == null || md.length() == 0 || md.equals("iPhone 17 Pro Max"), rel + ": scrubbed model " + md);
+            for (String k : ms.keySet()) {
+                T.check(!k.contains("MakerNote") && !k.startsWith("MakerUnknown") && !k.contains("Xiaomi"), rel + ": scrub trace " + k);
+            }
+            if (n0.containsKey("ExifIFD:FNumber")) T.eq("1.78", ms.get("ExifIFD:FNumber"), rel + ": scrub fnumber");
+            if (n0.containsKey("ExifIFD:FocalLength")) T.eq("6.765", ms.get("ExifIFD:FocalLength"), rel + ": scrub focal");
+            else T.eq(null, ms.get("ExifIFD:FocalLength"), rel + ": scrub creates nothing");
+            if (!n0.containsKey("ExifIFD:ApertureValue")) T.eq(null, ms.get("ExifIFD:ApertureValue"), rel + ": no AV created");
+            T.eq(n0.get("ExifIFD:DateTimeOriginal"), ms.get("ExifIFD:DateTimeOriginal"), rel + ": scrub keeps the date");
+            String sd = ms.get("IFD0:ImageDescription");
+            T.check(sd == null || !sd.toUpperCase(java.util.Locale.ROOT).contains("OLYMPUS"), rel + ": scrub description " + sd);
+            if (oldMake != null && oldMake.trim().length() >= 2 && !oldMake.trim().equalsIgnoreCase("Apple")) {
+                absent(sc, oldMake.trim(), rel + ": old make bytes after scrub");
+            }
+            assertNoNewWarnings(srcF, scF);
+            byte[] again = buf.clone();
+            EditReport rs2 = new EditReport();
+            T.check(ExifTiff.scrubInPlace(again, 37, tiff.length, spec, rs2, WHERE), rel + ": scrub again");
+            T.check(Arrays.equals(buf, again) && rs2.changes.isEmpty(), rel + ": scrub idempotent " + rs2);
+            done++;
+        }
+        T.check(done >= 5, "real samples processed: " + done);
+    }
