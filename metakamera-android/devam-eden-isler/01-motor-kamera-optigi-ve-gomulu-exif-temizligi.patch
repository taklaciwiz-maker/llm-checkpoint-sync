+    /**
+     * Drops the removed entries of {@code ifd} in place: the remaining 12-byte entries (and the
+     * next-IFD pointer) move left over the gaps, the count is decremented and the freed bytes at
+     * the end of the structure are zero-filled.
+     */
+    private void compact(TiffIfd ifd) {
+        int n = ifd.entries.size();
+        int kept = 0;
+        for (int i = 0; i < n; i++) {
+            if (!removed.contains(ifd.entries.get(i))) kept++;
+        }
+        if (kept == n) return;
+        int w = ifd.pos + 2;
+        for (int i = 0; i < n; i++) {
+            TiffEntry e = ifd.entries.get(i);
+            if (removed.contains(e)) continue;
+            if (e.entryPos != w) System.arraycopy(t, e.entryPos, t, w, 12);
+            w += 12;
+        }
+        tf.put16(t, ifd.pos, kept);
+        int end = ifd.srcEnd();
+        if (ifd.hasNextField) {
+            System.arraycopy(tf.d, ifd.pos + 2 + 12 * ifd.srcCount, t, w, 4);
+            w += 4;
+        }
+        Arrays.fill(t, w, end, (byte) 0);
+    }
+
+    /** Zero-fills the removed values except bytes still referenced by something that stays. */
+    private void zeroFreed() {
+        List<int[]> live = new ArrayList<int[]>();
+        live.add(new int[]{0, 8});
+        TiffIfd[] ifds = tf.allIfds();
+        for (TiffIfd ifd : ifds) {
+            if (ifd == null) continue;
+            int kept = 0;
+            for (int i = 0; i < ifd.entries.size(); i++) {
+                TiffEntry e = ifd.entries.get(i);
+                if (removed.contains(e)) continue;
+                kept++;
+                if (e.hasOutOfLineSourceValue()) live.add(new int[]{e.valuePos, e.valuePos + (int) e.byteLen});
+            }
+            live.add(new int[]{ifd.pos, ifd.pos + 2 + 12 * kept + (ifd.hasNextField ? 4 : 0)});
+            live.addAll(tf.dataRanges(ifd));
+        }
+        for (int k = 0; k < freed.size(); k++) {
+            int[] f = freed.get(k);
+            int s = Math.max(0, f[0]);
+            int e = Math.min(t.length, f[1]);
+            if (s >= e) continue;
+            List<int[]> ov = new ArrayList<int[]>();
+            for (int i = 0; i < live.size(); i++) {
+                int[] l = live.get(i);
+                if (l[0] < e && s < l[1]) ov.add(l);
+            }
+            Collections.sort(ov, BY_START);
+            int cur = s;
+            for (int i = 0; i < ov.size() && cur < e; i++) {
+                int[] l = ov.get(i);
+                if (l[0] > cur) Arrays.fill(t, cur, Math.min(l[0], e), (byte) 0);
+                cur = Math.max(cur, l[1]);
+            }
+            if (cur < e) Arrays.fill(t, cur, e, (byte) 0);
+        }
+    }
+}
