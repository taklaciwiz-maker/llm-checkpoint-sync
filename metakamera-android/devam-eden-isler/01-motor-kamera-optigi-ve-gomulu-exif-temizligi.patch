+        T.eq(SHORT, tr.u16(f35 + 2), "FocalLengthIn35mmFormat SHORT");
+        T.eq(24, tr.u16(f35 + 8), "FocalLengthIn35mmFormat");
+        int px = tr.entry(ex, 0xA002);
+        int py = tr.entry(ex, 0xA003);
+        T.eq(LONG, tr.u16(px + 2), "PixelXDimension keeps LONG");
+        T.eq(5712L, tr.u32(px + 8), "PixelXDimension");
+        T.eq(4284L, tr.u32(py + 8), "PixelYDimension");
+        assertSorted(tr, ex, "Exif IFD (ApertureValue created)");
+        // append-only: the MakerNote (kept: removeMakerNote=false) and the thumbnail did not move
