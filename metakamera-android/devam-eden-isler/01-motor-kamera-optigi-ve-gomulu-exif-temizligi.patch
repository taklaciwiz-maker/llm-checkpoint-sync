+    /** Copies a real sample into the work dir and extracts its EXIF TIFF block with exiftool (null when it has none). */
+    static byte[] realExif(File dir, String rel, File copy) throws IOException {
+        T.write(copy, T.read(new File(dir, rel)));
+        byte[] b = execBytes("exiftool", "-b", "-EXIF", copy.getAbsolutePath());
+        return b.length >= 8 && (b[0] == 'I' || b[0] == 'M') ? b : null;
+    }
+
+    static File exifFile(String name, byte[] tiff) throws IOException {
+        File f = T.file(name);
+        T.write(f, tiff);
+        return f;
+    }
