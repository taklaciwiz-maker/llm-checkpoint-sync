+        boolean reported = false;
+        for (int i = 0; i < es.size(); i++) {
+            TiffEntry e = es.get(i);
+            if (Optics.holds(tf, e, q)) continue;
+            boolean rational = e.type == T_RATIONAL || e.type == T_SRATIONAL;
+            long[] tc = new long[2];
+            byte[] v;
+            switch (q.kind) {
