+    public static void testScrubInPlaceRejectsBadInput() throws Exception {
+        Fx fx = build(opt(true));
+        byte[] buf = embed(fx.tiff);
+        byte[] orig = buf.clone();
+        EditSpec s = T.appleSpec();
+        T.check(!ExifTiff.scrubInPlace(null, 0, 10, s, null, WHERE), "null buffer");
+        T.check(!ExifTiff.scrubInPlace(buf, -1, 10, s, null, WHERE), "negative offset");
+        T.check(!ExifTiff.scrubInPlace(buf, 37, buf.length, s, null, WHERE), "beyond the end");
+        T.check(!ExifTiff.scrubInPlace(buf, 37, -5, s, null, WHERE), "negative length");
+        T.check(!ExifTiff.scrubInPlace(buf, Integer.MAX_VALUE, Integer.MAX_VALUE, s, null, WHERE), "overflowing range");
+        T.check(!ExifTiff.scrubInPlace(buf, 0, buf.length, s, null, WHERE), "not a TIFF header at the offset");
+        T.check(!ExifTiff.scrubInPlace(buf, 37, 7, s, null, WHERE), "too short");
+        T.check(Arrays.equals(orig, buf), "untouched");
+        EditReport r = new EditReport();
+        T.check(ExifTiff.scrubInPlace(buf, 37, fx.tiff.length, null, r, WHERE), "null spec: parsed, nothing to do");
+        T.check(Arrays.equals(orig, buf) && r.changes.isEmpty(), "null spec changes nothing");
+        // truncated range: the IFD0 is cut -> parse fails, nothing written
+        TR tr = new TR(fx.tiff);
+        EditReport rt = new EditReport();
+        rt.change("önceki");
+        T.check(!ExifTiff.scrubInPlace(buf, 37, tr.ifd0() + 10, s, rt, WHERE), "truncated IFD0");
+        T.check(Arrays.equals(orig, buf), "untouched after a failure");
+        T.eq(1, rt.changes.size(), "report untouched after a failure");
+    }
