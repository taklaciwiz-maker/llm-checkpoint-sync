+            int mk = tr.entry(tr.ifd0(), 0x010F);
+            T.eq("HTC", tr.str(tr.ifd0(), 0x010F), "make");
+            T.eq(4L, tr.u32(mk + 4), "inline count grew to 4");
+            T.eq("", tr.str(tr.ifd0(), 0x0110), "model blanked");
+            T.eq(4L, tr.u32(tr.entry(tr.ifd0(), 0x0110) + 4), "model count kept");
+            T.eq("", tr.str(tr.ifd0(), 0x0131), "software blanked");
+            absent(out, "ALN-AL00 4.0.0", "old software bytes");
+            T.eq(Arrays.asList("Önizleme: EXIF Make: LG → HTC", "Önizleme: EXIF Model temizlendi (yeni değer sığmadı)",
+                    "Önizleme: EXIF Software temizlendi"), rep.changes, "report");
+            Map<String, String> m = T.exif(jpeg("scrub-slots-" + le + ".jpg", out));
+            T.eq("HTC", m.get("IFD0:Make"), "exiftool make");
+            assertNoNewWarnings(jpeg("scrub-slots-" + le + "-in.jpg", fx.tiff), jpeg("scrub-slots-" + le + ".jpg", out));
+            EditReport r2 = new EditReport();
+            byte[] b2 = b.clone();
+            T.check(ExifTiff.scrubInPlace(b2, 37, fx.tiff.length, s, r2, "Önizleme"), "again");
+            T.check(Arrays.equals(b, b2) && r2.changes.isEmpty(), "idempotent " + r2);
