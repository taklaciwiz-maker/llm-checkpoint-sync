+                case Optics.K_FNUMBER:
+                case Optics.K_APEX:
+                case Optics.K_LENS_SPEC: {
+                    long n = q.kind == Optics.K_LENS_SPEC ? 4 : 1;
+                    if (!rational || e.count != n || !tf.exclusive(e)) continue;
+                    v = Optics.encode(tf, q, e.type, tc);
+                    System.arraycopy(v, 0, t, e.valuePos, v.length);
+                    tf.put16(t, e.entryPos + 2, T_RATIONAL);
+                    break;
+                }
+                case Optics.K_SHORT:
+                case Optics.K_DIM: {
+                    if (e.count != 1 || (e.type != T_SHORT && e.type != T_LONG)) continue;
