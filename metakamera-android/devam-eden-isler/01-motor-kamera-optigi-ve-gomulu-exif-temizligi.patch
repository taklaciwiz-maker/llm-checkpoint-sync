+                }
+                default:
+                    continue;
+            }
+            changed = true;
+            if (!reported) {
+                reported = true;
+                r.change(p + prefix + q.name + ": " + Optics.oldText(tf, e, q) + " → " + Optics.newText(q) + Optics.unit(q));
