+            zeroed(out, desc, "OLYMPUS DIGITAL CAMERA");
+            zeroed(out, uc, "olympus-pen");
+            intact(out, fan, "OLYMPUSFAN");
+            absent(out, "OLYMPUS", "brand token");
+            absent(out, "olympus", "brand token (lower case)");
