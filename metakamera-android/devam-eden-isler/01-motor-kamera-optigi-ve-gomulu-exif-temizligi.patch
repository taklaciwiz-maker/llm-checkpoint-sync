+            Ent desc = ascii(0x010E, "OLYMPUS DIGITAL CAMERA         "); // the camera default
+            Ent uc = userComment("ASCII", "olympus-pen ile tatil", le);    // whole word (hyphen)
+            Ent fan = xp(0x9C9C, "OLYMPUSFAN kulubu");                  // not the whole word
+            o.extraIfd0.add(desc);
+            o.extraExif.add(uc);
+            o.extraIfd0.add(fan);
