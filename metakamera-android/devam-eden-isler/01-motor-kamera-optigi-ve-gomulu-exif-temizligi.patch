+    /** Equal values in another encoding (693/100, Apple-style ApertureValue) are not rewritten. */
+    public static void testOpticsEqualValuesKept() throws Exception {
+        for (boolean le : new boolean[]{true, false}) {
+            Opt o = opt(le);
+            TB t = new TB(le);
+            o.extraExif.add(new Ent(0x920A, RATIONAL, 1, t.lg(693, 100)));
+            o.extraExif.add(new Ent(0x9202, RATIONAL, 1, t.lg(27767, 23734))); // Apple: f/1.5
+            o.extraExif.add(new Ent(0xA405, LONG, 1, t.lg(24)));              // LONG instead of SHORT
+            Fx fx = build(o);
+            byte[] b = fx.tiff.clone();
+            // FNumber 18/10 -> 3/2 (f/1.5)
+            TR tr = new TR(b);
+            int fn = (int) tr.field(tr.exif(), 0x829D);
+            TB w = new TB(le);
+            w.b = b;
+            w.put32(fn, 3);
+            w.put32(fn + 4, 2);
+            EditSpec s = nullSpec();
+            s.focalLengthMm = 6.93;
+            s.fNumber = 1.5;
+            s.focalLength35mm = 24;
+            s.exifImageWidth = 64;
+            s.exifImageHeight = 48;
+            EditReport rep = new EditReport();
+            T.check(edit(b, s, rep) == b, "equal values: nothing to do " + rep);
+            T.eq(0, rep.changes.size(), "no report " + rep);
+            // a really different value is rewritten
+            s.fNumber = 1.4;
+            rep = new EditReport();
+            byte[] out = edit(b, s, rep);
+            T.eq(Arrays.asList("EXIF FNumber: f/1.5 → f/1.4", "EXIF ApertureValue: f/1.5 → f/1.4"), rep.changes, "report");
+            T.eq(b.length, out.length, "both rationals rewritten in place");
+        }
+    }
