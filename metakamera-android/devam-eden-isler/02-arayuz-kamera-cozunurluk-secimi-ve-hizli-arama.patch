diff --git a/metakamera-android/src/com/metakamera/app/DeviceSearchAdapter.java b/metakamera-android/src/com/metakamera/app/DeviceSearchAdapter.java
new file mode 100644
index 0000000..0dd6e83
--- /dev/null
+++ b/metakamera-android/src/com/metakamera/app/DeviceSearchAdapter.java
@@ -0,0 +1,120 @@
+package com.metakamera.app;
+
+import android.content.Context;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.BaseAdapter;
+import android.widget.Filter;
+import android.widget.Filterable;
+import android.widget.TextView;
+
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Suggestions of the main-screen quick phone search (an AutoCompleteTextView): at most
+ * {@link #MAX_RESULTS} ranked matches from {@link DeviceDatabase#search}, two-line rows
+ * ("Samsung Galaxy S25 Ultra" + year / "samsung · SM-S938B · Ana 200 MP · Geniş 50 MP ...").
+ *
+ * Filtering runs on the Filter's own background thread; the database is immutable and published through
+ * a volatile field, the result list is only touched on the main thread (publishResults / getView).
+ */
+final class DeviceSearchAdapter extends BaseAdapter implements Filterable {
+
+    static final int MAX_RESULTS = 12;
+
+    private final LayoutInflater inflater;
+    private volatile DeviceDatabase db;
+    private List<Device> results = Collections.emptyList();
+    private String resultQuery = "";
+
+    DeviceSearchAdapter(Context context) {
+        this.inflater = LayoutInflater.from(context);
+    }
+
+    void setDatabase(DeviceDatabase database) {
+        db = database;
+    }
+
+    /** The query the current suggestions belong to (used to pick a typed regional model code). */
+    String resultQuery() {
+        return resultQuery;
+    }
+
+    @Override
+    public int getCount() {
+        return results.size();
+    }
+
+    @Override
+    public Object getItem(int position) {
+        return position >= 0 && position < results.size() ? results.get(position) : null;
+    }
+
+    @Override
+    public long getItemId(int position) {
+        return position;
+    }
+
+    @Override
+    public View getView(int position, View convertView, ViewGroup parent) {
+        View v = convertView != null ? convertView : inflater.inflate(R.layout.row_search, parent, false);
+        Object o = getItem(position);
+        if (!(o instanceof Device)) return v;
+        Device d = (Device) o;
+        ((TextView) v.findViewById(R.id.search_title)).setText(d.displayName());
+        TextView year = (TextView) v.findViewById(R.id.search_year);
+        year.setText(d.year > 0 ? String.valueOf(d.year) : "");
+        UiUtil.setVisible(year, d.year > 0);
+        String variant = d.variantMatching(resultQuery);
+        StringBuilder detail = new StringBuilder(d.make).append(CameraText.SEP)
+                .append(variant != null ? variant : d.model);
+        String cams = d.cameraSummary();
+        if (cams.length() > 0) detail.append(CameraText.SEP).append(cams);
+        ((TextView) v.findViewById(R.id.search_detail)).setText(detail);
+        return v;
+    }
+
+    @Override
+    public Filter getFilter() {
+        return filter;
+    }
+
+    private static final class Result {
+        final String query;
+        final List<Device> devices;
+
+        Result(String query, List<Device> devices) {
+            this.query = query;
+            this.devices = devices;
+        }
+    }
+
+    private final Filter filter = new Filter() {
+        @Override
+        protected FilterResults performFiltering(CharSequence constraint) {
+            String q = constraint == null ? "" : constraint.toString();
+            DeviceDatabase d = db;
+            List<Device> list = d == null ? Collections.<Device>emptyList() : d.search(q, MAX_RESULTS);
+            FilterResults r = new FilterResults();
+            r.values = new Result(q, list);
+            r.count = list.size();
+            return r;
+        }
+
+        @Override
+        protected void publishResults(CharSequence constraint, FilterResults r) {
+            Result res = r != null && r.values instanceof Result ? (Result) r.values : null;
+            results = res == null ? Collections.<Device>emptyList() : res.devices;
+            resultQuery = res == null ? "" : res.query;
+            if (results.isEmpty()) notifyDataSetInvalidated();
+            else notifyDataSetChanged();
+        }
+
+        @Override
+        public CharSequence convertResultToString(Object resultValue) {
+            return resultValue instanceof Device ? ((Device) resultValue).displayName() : "";
+        }
+    };
+}
