+    /** "• Odak uzaklığı: 5,1 mm → 6,77 mm" lines for the optics / EXIF size values either file has. */
+    private static String cameraChanges(Context c, MediaInfo before, MediaInfo after) {
+        StringBuilder sb = new StringBuilder();
+        change(c, sb, "Odak uzaklığı", focal(before), focal(after));
+        change(c, sb, "Diyafram", aperture(before), aperture(after));
+        change(c, sb, "35 mm eşdeğeri", focal35(before), focal35(after));
+        change(c, sb, "EXIF çözünürlüğü", exifSize(before), exifSize(after));
+        return sb.toString();
+    }
+
+    private static void change(Context c, StringBuilder sb, String key, String before, String after) {
+        if (before == null && after == null) return;
+        sb.append("\n• ").append(key).append(": ");
+        if (before != null && before.equals(after)) {
+            sb.append(after).append(" (").append(c.getString(R.string.item_unchanged)).append(')');
+        } else {
+            sb.append(before != null ? before : "—").append(" → ").append(after != null ? after : "—");
+        }
+    }
+
