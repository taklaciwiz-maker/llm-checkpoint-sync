diff --git a/metakamera-android/src/com/metakamera/app/CameraModule.java b/metakamera-android/src/com/metakamera/app/CameraModule.java
new file mode 100644
index 0000000..f98ed6e
--- /dev/null
+++ b/metakamera-android/src/com/metakamera/app/CameraModule.java
@@ -0,0 +1,116 @@
+package com.metakamera.app;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * One rear camera of a phone ("cameras" of devices.json v2). Immutable, no Android dependencies.
+ * Unknown numbers are 0, an unknown lens name is "".
+ */
+public final class CameraModule {
+
+    public static final int ROLE_MAIN = 0;
+    public static final int ROLE_ULTRAWIDE = 1;
+    public static final int ROLE_TELEPHOTO = 2;
+    public static final int ROLE_OTHER = 3;
+
+    /** Largest accepted output edge; anything bigger is treated as a database error. */
+    private static final int MAX_EDGE = 65535;
+
+    /** One of the ROLE_* constants. */
+    public final int role;
+    /** Zoom factor relative to the main camera (0.5, 1, 3, 5 ...), 0 = unknown. */
+    public final double zoom;
+    /** Sensor resolution as marketed, in megapixels (48, 50.3, 200 ...), 0 = unknown. */
+    public final double mp;
+    /** 35 mm equivalent focal length in mm, 0 = unknown. */
+    public final int f35;
+    /** Real focal length in mm, 0 = unknown. */
+    public final double fmm;
+    /** Aperture (f-number), 0 = unknown. */
+    public final double fn;
+    /** EXIF LensModel the phone writes for this camera, "" = unknown. */
+    public final String lens;
+    /** Output sizes {W, H} with W >= H, duplicates removed; [0] is the camera's default. */
+    private final int[][] outputs;
+
+    public CameraModule(String role, double zoom, double mp, int f35, double fmm, double fn, String lens,
+                        int[][] outputs) {
+        this.role = parseRole(role);
+        this.zoom = valid(zoom, 1000) ? zoom : 0;
+        this.mp = valid(mp, 10000) ? mp : 0;
+        this.f35 = f35 > 0 && f35 < 10000 ? f35 : 0;
+        this.fmm = valid(fmm, 1000) ? fmm : 0;
+        this.fn = valid(fn, 100) ? fn : 0;
+        this.lens = lens == null ? "" : lens.trim();
+        List<int[]> outs = new ArrayList<int[]>();
+        if (outputs != null) {
+            for (int[] o : outputs) {
+                if (o == null || o.length < 2) continue;
+                int w = Math.max(o[0], o[1]);
+                int h = Math.min(o[0], o[1]);
+                if (h <= 0 || w > MAX_EDGE) continue;
+                boolean dup = false;
+                for (int[] e : outs) {
+                    if (e[0] == w && e[1] == h) {
+                        dup = true;
+                        break;
+                    }
+                }
+                if (!dup) outs.add(new int[]{w, h});
+            }
+        }
+        this.outputs = outs.toArray(new int[outs.size()][]);
+    }
+
+    /** "main" / "wide" -> main, "ultrawide" -> ultra-wide, "telephoto" / "periscope" -> telephoto. */
+    static int parseRole(String r) {
+        if (r == null) return ROLE_OTHER;
+        String n = r.trim().toLowerCase(Locale.ROOT).replace("-", "").replace("_", "").replace(" ", "");
+        if (n.equals("main") || n.equals("wide") || n.equals("primary")) return ROLE_MAIN;
+        if (n.startsWith("ultra") || n.equals("uw")) return ROLE_ULTRAWIDE;
+        if (n.startsWith("tele") || n.contains("periscope")) return ROLE_TELEPHOTO;
+        return ROLE_OTHER;
+    }
+
+    private static boolean valid(double v, double max) {
+        return !Double.isNaN(v) && !Double.isInfinite(v) && v > 0 && v < max;
+    }
+
+    /** True when the entry carries anything usable (entries without data are dropped by the parser). */
+    boolean hasData() {
+        return role != ROLE_OTHER || zoom > 0 || mp > 0 || f35 > 0 || fmm > 0 || fn > 0 || lens.length() > 0
+                || outputs.length > 0;
+    }
+
+    public int outputCount() {
+        return outputs.length;
+    }
+
+    /** Output size {W, H} (W >= H) at {@code index}, or null when out of range. A copy. */
+    public int[] output(int index) {
+        if (index < 0 || index >= outputs.length) return null;
+        return new int[]{outputs[index][0], outputs[index][1]};
+    }
+
+    /** "8064x6048": the key remembered in the preferences for an output size. */
+    public String outputKey(int index) {
+        if (index < 0 || index >= outputs.length) return null;
+        return outputs[index][0] + "x" + outputs[index][1];
+    }
+
+    /** Index of the output whose {@link #outputKey} is {@code key}, -1 when there is none. */
+    public int outputIndex(String key) {
+        if (key == null) return -1;
+        for (int i = 0; i < outputs.length; i++) {
+            if (key.equals(outputKey(i))) return i;
+        }
+        return -1;
+    }
+
+    /** Sort rank: main, ultra-wide, telephoto, others. */
+    int roleRank() {
+        return role;
+    }
+}
diff --git a/metakamera-android/src/com/metakamera/app/CameraText.java b/metakamera-android/src/com/metakamera/app/CameraText.java
new file mode 100644
index 0000000..0761e5e
--- /dev/null
+++ b/metakamera-android/src/com/metakamera/app/CameraText.java
@@ -0,0 +1,154 @@
+package com.metakamera.app;
+
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Turkish labels for camera modules and optics values. Pure Java (no Android dependencies) so the
+ * formatting can be checked on a plain JVM.
+ *
+ * <pre>
+ * cameraLabel  "Ana kamera (1x) · 48 MP · f/1.8 · 24 mm"
+ * summary      "Ana 200 MP · Geniş 50 MP · Tele 3x 10 MP · Tele 5x 50 MP"
+ * outputLabel  "24 MP · 5712 × 4284 (varsayılan)", "12,5 MP · 4080 × 3060"
+ * </pre>
+ * Zoom factors and f-numbers keep the photographic dot notation ("0.5x", "f/2.2"); megapixels and
+ * millimetres use the Turkish decimal comma ("12,5 MP", "6,77 mm").
+ */
+final class CameraText {
+
+    static final String SEP = " · ";
+
+    private CameraText() {
+    }
+
+    static String roleLong(int role) {
+        switch (role) {
+            case CameraModule.ROLE_MAIN:
+                return "Ana kamera";
+            case CameraModule.ROLE_ULTRAWIDE:
+                return "Geniş açı";
+            case CameraModule.ROLE_TELEPHOTO:
+                return "Telefoto";
+            default:
+                return "Kamera";
+        }
+    }
+
+    static String roleShort(int role) {
+        switch (role) {
+            case CameraModule.ROLE_MAIN:
+                return "Ana";
+            case CameraModule.ROLE_ULTRAWIDE:
+                return "Geniş";
+            case CameraModule.ROLE_TELEPHOTO:
+                return "Tele";
+            default:
+                return "Kamera";
+        }
+    }
+
+    /** "Ana kamera (1x) · 48 MP · f/1.8 · 24 mm"; unknown parts are left out. */
+    static String cameraLabel(CameraModule c) {
+        StringBuilder sb = new StringBuilder(roleLong(c.role));
+        if (c.zoom > 0) sb.append(" (").append(zoom(c.zoom)).append(')');
+        if (c.mp > 0) sb.append(SEP).append(megapixels(c.mp)).append(" MP");
+        if (c.fn > 0) sb.append(SEP).append(fNumber(c.fn));
+        if (c.f35 > 0) sb.append(SEP).append(c.f35).append(" mm");
+        return sb.toString();
+    }
+
+    /** "Ana 200 MP · Geniş 50 MP · Tele 3x 10 MP", "" for a phone without camera data. */
+    static String summary(List<CameraModule> cameras) {
+        StringBuilder sb = new StringBuilder();
+        if (cameras == null) return "";
+        for (CameraModule c : cameras) {
+            if (sb.length() > 0) sb.append(SEP);
+            sb.append(roleShort(c.role));
+            if (c.zoom > 0 && c.role != CameraModule.ROLE_MAIN && c.role != CameraModule.ROLE_ULTRAWIDE) {
+                sb.append(' ').append(zoom(c.zoom));
+            }
+            if (c.mp > 0) sb.append(' ').append(megapixels(c.mp)).append(" MP");
+        }
+        return sb.toString();
+    }
+
+    /** "24 MP · 5712 × 4284 (varsayılan)" for output {@code index} of {@code c}; null when out of range. */
+    static String outputLabel(CameraModule c, int index) {
+        int[] o = c.output(index);
+        if (o == null) return null;
+        String s = outputMegapixels(o[0], o[1], c.mp) + " MP" + SEP + size(o[0], o[1]);
+        return index == 0 ? s + " (varsayılan)" : s;
+    }
+
+    /**
+     * Megapixels of a w x h output as a person would name it. The exact value w*h/1e6 is snapped to the
+     * camera's marketed resolution or its pixel-binned modes (mp/4, mp/9, mp/16) when it is within 3 %,
+     * so 8064 × 6048 of a 48 MP camera is "48" and 4032 × 3024 is "12". Otherwise: one decimal below
+     * 20 MP unless integral (4080 × 3060 -> "12,5"), whole numbers from 20 MP up (5712 × 4284 -> "24").
+     */
+    static String outputMegapixels(int w, int h, double cameraMp) {
+        double exact = (double) w * (double) h / 1e6;
+        if (exact <= 0) return "0";
+        if (cameraMp > 0) {
+            double best = 0;
+            double bestDiff = Double.MAX_VALUE;
+            int[] divisors = {1, 4, 9, 16};
+            for (int div : divisors) {
+                double cand = cameraMp / div;
+                if (cand < 1) continue;
+                double diff = Math.abs(exact - cand);
+                if (diff <= cand * 0.03 && diff < bestDiff) {
+                    best = cand;
+                    bestDiff = diff;
+                }
+            }
+            if (best > 0) return megapixels(best);
+        }
+        if (exact < 20) return oneDecimal(exact);
+        return Long.toString(Math.round(exact));
+    }
+
+    /** Marketed megapixels: whole numbers as is ("48"), others with one decimal ("10,8", "50,3"). */
+    static String megapixels(double mp) {
+        return oneDecimal(mp);
+    }
+
+    /** "0.5x", "1x", "3.5x". */
+    static String zoom(double z) {
+        return trim(z, 2, '.') + "x";
+    }
+
+    /** "f/1.8", "f/1.65". */
+    static String fNumber(double fn) {
+        return "f/" + trim(fn, 2, '.');
+    }
+
+    /** "6,77 mm", "15 mm". */
+    static String mm(double v) {
+        return trim(v, 2, ',') + " mm";
+    }
+
+    /** "5712 × 4284". */
+    static String size(int w, int h) {
+        return w + " × " + h;
+    }
+
+    /** One decimal with a Turkish comma, without ",0": 12.19 -> "12,2", 7.99 -> "8", 50.3 -> "50,3". */
+    static String oneDecimal(double v) {
+        return trim(v, 1, ',');
+    }
+
+    /** {@code v} rounded to at most {@code decimals} digits, trailing zeros removed. */
+    static String trim(double v, int decimals, char separator) {
+        String s = String.format(Locale.ROOT, "%." + decimals + "f", v);
+        if (s.indexOf('.') >= 0) {
+            int end = s.length();
+            while (end > 0 && s.charAt(end - 1) == '0') end--;
+            if (end > 0 && s.charAt(end - 1) == '.') end--;
+            s = s.substring(0, end);
+        }
+        if (s.equals("-0")) s = "0";
+        return separator == '.' ? s : s.replace('.', separator);
+    }
+}
